# ==============================================================================
# Flashcards API — Variáveis de Ambiente (EXEMPLO)
# ------------------------------------------------------------------------------
# Use para rodar a API LOCALMENTE (sem Docker), exportando as variáveis antes de
# `mvn spring-boot:run`, ou copiando para um `.env` e usando `env $(cat .env)`.
#
#   export SPRING_PROFILES_ACTIVE=dev   # dev usa o PostgreSQL/MinIO do compose
#   mvn spring-boot:run
#
# Perfis:
#   dev  -> PostgreSQL + MinIO locais (defaults apontam p/ localhost)
#   prod -> tudo obrigatório via env (fail-fast no boot)
#   test -> H2 em memória (usado pelos testes)
#
# Sem OPENROUTER_API_KEY a API sobe com o MockOpenRouterClient (não gasta crédito).
# ==============================================================================

# ------------------------------------------------------------------------------
# Spring
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# PostgreSQL (perfil dev; em prod o compose injeta DB_HOST=postgres)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashcards
DB_USER=flashcards
DB_PASSWORD=flashcards

# ------------------------------------------------------------------------------
# JWT — obrigatório em prod (mínimo 32 caracteres). Gere: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-minimo-32-caracteres-0123456789

# ------------------------------------------------------------------------------
# Usuário único semeado no boot (login da sua mãe)
# ------------------------------------------------------------------------------
APP_USER_EMAIL=mae@exemplo.com
APP_USER_PASSWORD=change-me

# ------------------------------------------------------------------------------
# CORS: origem exata do frontend
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OpenRouter (vazio => MockOpenRouterClient). Também editável em /settings.
# ------------------------------------------------------------------------------
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_READER_MODEL=google/gemini-2.5-flash
OPENROUTER_GENERATOR_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Flashcards
# Override do prompt base (opcional; default em application.yaml)
# APP_OPENROUTER_BASE_PROMPT=

# ------------------------------------------------------------------------------
# Bucket de arquivos (MinIO local). Em prod use APP_S3_* (ver application-prod.yaml).
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=flashcards
S3_REGION=us-east-1
