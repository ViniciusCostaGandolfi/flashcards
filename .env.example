# ==============================================================================
# Flashcards — Variáveis de Ambiente (EXEMPLO, raiz)
# ------------------------------------------------------------------------------
# Copie para `.env` (na raiz) e preencha TODOS os valores:
#   cp .env.example .env
# O `.env` está no .gitignore — nunca commitar segredos reais.
#
# O docker-compose.yaml lê TODAS as variáveis deste arquivo. Segredos usam
# ${VAR:?} (sem default): se faltar, `docker compose` falha na interpolação.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=flashcards
DB_USER=flashcards
# Produção: gere um valor forte. Ex.: openssl rand -hex 32
DB_PASSWORD=flashcards

# ------------------------------------------------------------------------------
# Bucket de arquivos (MinIO / S3-compatível)
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=flashcards
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ------------------------------------------------------------------------------
# JWT — OBRIGATÓRIO (mínimo 32 caracteres)
# Gere com: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=change-me-minimo-32-caracteres-0123456789

# ------------------------------------------------------------------------------
# Usuário único semeado no boot (login da sua mãe)
# ------------------------------------------------------------------------------
APP_USER_EMAIL=mae@exemplo.com
APP_USER_PASSWORD=change-me

# ------------------------------------------------------------------------------
# OpenRouter — OBRIGATÓRIO (chave paga; https://openrouter.ai/keys)
# Modelos também editáveis na tela /settings do app.
# ------------------------------------------------------------------------------
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-change-me
# Leitor (visão): lê imagens/PDFs -> texto
OPENROUTER_READER_MODEL=google/gemini-2.5-flash
# Gerador: cria os flashcards a partir do texto
OPENROUTER_GENERATOR_MODEL=deepseek/deepseek-v4.1-flash

# ------------------------------------------------------------------------------
# Domínios / CORS
#   FRONTEND_URL precisa ser a origem exata do web (CORS da API).
# ------------------------------------------------------------------------------
FRONTEND_URL=https://flashcards.vgandolfi.dev

# ------------------------------------------------------------------------------
# Frontend (build do flashcards-web — embutido no bundle pelo Vite)
#   resolveBaseUrl() anexa /api/v1 se ausente.
#   Dev local:   http://localhost:8080
#   Produção:    https://api-flashcards.vgandolfi.dev
# ------------------------------------------------------------------------------
VITE_API_URL=https://api-flashcards.vgandolfi.dev
